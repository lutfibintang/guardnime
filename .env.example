# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Channel ID tempat moderation log dikirim
MODERATION_LOG_CHANNEL_ID=

# Google Spreadsheet ID (dari URL spreadsheet)
# Contoh URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_DISINI/edit
GOOGLE_SPREADSHEET_ID=

# Google Service Account Email
# Contoh: bot@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Google Service Account Private Key
# Copy seluruh isi private key dari JSON file, termasuk -----BEGIN PRIVATE KEY----- dan -----END PRIVATE KEY-----
# Pastikan menggunakan tanda kutip ganda dan \n untuk newline
GOOGLE_PRIVATE_KEY=
